def cmd_quantize(args):
    import torch;p,o,s=args.model,args.output,args.scheme
    if not p:print(er("Need -m"));return 1
    if not o:print(er("Need -o"));return 1
    if s not in SCHEMES:print(er(f"Unknown scheme: {s}"));return 1
    sys.path.insert(0,SELF)
    from schemes import get_scheme as gs
    sch=gs(s);qfn=sch["quantize"];qkw=dict(sch.get("quantize_kwargs",{}))
    print(f"\n  {hd("Scheme:")} {sch["name"]}")
    print(f"  Loading: {p}...");t0=time.time()
    z=torch.load(p,map_location="cpu",weights_only=True)
    nl=max((int(k.split(".")[1]) for k in z if k.startswith("blocks.") and len(k.split("."))>=2),default=0)+1
    # Collect quantizable keys
    keys_to_q = [(k, clsf(k, nl)) for k in z if clsf(k, nl) is not None]
    total = len(keys_to_q)
    print(f"  {nl} layers, {total} quantizable weights, {len(z)} total keys\n")

    # Quantize with progress
    if _RICH:
        with Progress(SpinnerColumn(), TextColumn("[progress.description]{task.description}"), BarColumn(), TextColumn("{task.completed}/{task.total}"), TimeElapsedColumn(), console=_r) as prog:
            task = prog.add_task(f"  Quantizing [{sch['name']}]", total=total)
            qc = 0
            for k, info in keys_to_q:
                w = z[k].float()
                z[k] = qfn(w, **qkw)
                qc += 1
                prog.advance(task)
        print()
    else:
        qc = 0
        for i, (k, info) in enumerate(keys_to_q):
            w = z[k].float()
            z[k] = qfn(w, **qkw)
            qc += 1
            if (i+1) % 24 == 0 or i+1 == total:
                pct = (i+1)/total*100
                bar = chr(9608) * int(pct/5) + chr(9617) * (20 - int(pct/5))
                print(f"\r  {bar} {pct:5.1f}% ({i+1}/{total})", end="", flush=True)
        print()

    # Save
    z["quant_meta"]={"scheme":s,"format":sch["format"],"ts":time.strftime("%Y-%m-%d %H:%M:%S")}
    os.makedirs(os.path.dirname(o) or ".",exist_ok=True)
    print(f"  Saving to {o}...", end=" ", flush=True)
    torch.save(z,o)
    print("done")

    # Summary box
    sz=os.path.getsize(o);orig=os.path.getsize(p);dt=time.time()-t0
    print()
    print(f"  {hd('Quantization Complete')}")
    print(f"  {dm(chr(8722)*44)}")
    print(f"  {C('Scheme:',BD)}      {sch['name']}")
    print(f"  {C('Format:',BD)}      {sch['format']}")
    print(f"  {C('Weights:',BD)}     {qc:,} / {total} (6 per layer)")
    print(f"  {C('Layers:',BD)}      {nl}")
    print(f"  {C('Time:',BD)}        {dt:.1f}s ({qc/dt:.0f} weights/s)")
    print(f"  {dm(chr(8722)*44)}")
    ratio = orig/max(sz,1)
    sav = (1 - sz/max(orig,1)) * 100
    orig_h = hs(orig); sz_h = hs(sz)
    if ratio > 1:
        print(f"  {C('Size:',BD)}        {orig_h} {C('->',DM)} {C(sz_h,GN)} ({C(f'{ratio:.2f}x',GN)}, save {C(f'{sav:.0f}%',GN)})")
    else:
        print(f"  {C('Size:',BD)}        {orig_h} {C('->',DM)} {C(sz_h,YL)} ({C(f'{ratio:.2f}x',YL)})")
    print(f"  {dm(chr(8722)*44)}")
    return 0

def cmd_compare(args):
    import torch;p,od=args.model,args.outdir
    if not p:print(er("Need -m"));return 1
    od=od or "./compare_out";os.makedirs(od,exist_ok=True)
    sys.path.insert(0,SELF)
    from schemes import get_scheme as gs
    orig=os.path.getsize(p);print(f"\n  Source: {p} ({hs(orig)})")
    z_orig=torch.load(p,map_location="cpu",weights_only=True)
    nl=max((int(k.split(".")[1]) for k in z_orig if k.startswith("blocks.") and len(k.split("."))>=2),default=0)+1
    results=[]
    for sn,ss in SCHEMES.items():
        sch=gs(sn);qfn=sch["quantize"];qkw=dict(sch.get("quantize_kwargs",{}))
        z={k:v.clone() if hasattr(v,"clone") else v for k,v in z_orig.items()}
        for k in list(z.keys()):
            if clsf(k,nl) is None:continue
            w=z[k].float();z[k]=qfn(w,**qkw)
        out=os.path.join(od,f"model_{sn}.pth")
        torch.save(z,out);del z;gc.collect()
        sz=os.path.getsize(out)
        results.append(dict(s=sn,n=ss["n"],sz=sz,r=sz/orig))
        print(f"  {ok(sn):40s} -> {hs(sz):>8s} ({sz/orig:.2f}x)")
    rt("Comparison",[("Scheme",20),("Name",20),("Size",8),("Ratio",6)],
        [(r["s"],r["n"],hs(r["sz"]),f"{r["r"]:.2f}x") for r in results])
    return 0

