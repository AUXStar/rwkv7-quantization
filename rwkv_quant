def clsf(k,nl):
    ps=k.split(".")
    if len(ps)<4 or ps[0]!="blocks":return None
    try:ly=int(ps[1])
    except:return None
    if ly<0 or ly>=nl:return None
    c=CM.get(ps[3]) if ps[2]=="att" else (FM.get(ps[3]) if ps[2]=="ffn" else None)
    return (ly,c) if c in QUANT else None

