# ── Weight classification ─────────────────────────────────────
QUANT={"att_r","att_k","att_v","att_o","ffn_k","ffn_v"}
CM={"receptance":"att_r","key":"att_k","value":"att_v","output":"att_o"}
FM={"key":"ffn_k","value":"ffn_v"}

def clsf(k,nl):
    ps=k.split(".")
    if len(ps)<4 or ps[0]!="blocks": return None
    try: ly=int(ps[1])
    except: return None
    if ly<0 or ly>=nl: return None
    c=CM.get(ps[3]) if ps[2]=="att" else (FM.get(ps[3]) if ps[2]=="ffn" else None)
    return (ly,c) if c in QUANT else None

def load_state(p):
    """Load model state dict with torch."""
    import torch
    z=torch.load(p,map_location="cpu",weights_only=True)
    nl=max((int(k.split(".")[1]) for k in z if k.startswith("blocks.") and len(k.split("."))>=2),default=0)+1
    return z, nl
