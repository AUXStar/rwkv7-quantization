    return 0

def cmd_sensitivity(args):
    import torch;p=args.model
    if not p:print(er("Need -m"));return 1
    z=torch.load(p,map_location="cpu",weights_only=True)
    nl=max((int(k.split(".")[1]) for k in z if k.startswith("blocks.") and len(k.split("."))>=2),default=0)+1
    print(f"\n  {hd("Analyzing:")} {p} ({nl} layers)")
    from collections import defaultdict;groups=defaultdict(list)
    for k in sorted(z.keys()):
        v=z[k];info=clsf(k,nl);comp=info[1] if info else "other"
        if isinstance(v,torch.Tensor) and v.dim()==2 and v.numel()>=10000:
            wf=v.float();std_v=float(wf.std())
            sk=float(((wf-wf.mean())**3).mean()/(std_v**3+1e-20))
            ku=float(((wf-wf.mean())**4).mean()/(std_v**4+1e-20)-3)
            groups[comp].append(dict(k=k,shape=list(v.shape),mean=round(float(wf.mean()),4),std=round(std_v,4),skew=round(sk,3),kurt=round(ku,3)))
    cols=[("Component",14),("Count",5),("Avg Std",8),("Avg Skew",8),("Avg Kurt",8)]
    rows=[]
    for comp in sorted(groups.keys()):
        gs_=groups[comp];n=len(gs_)
        if n==0:continue
        avg_std=sum(x["std"] for x in gs_)/n
        avg_skew=sum(x["skew"] for x in gs_)/n
        avg_kurt=sum(x["kurt"] for x in gs_)/n
        rows.append((comp,str(n),f"{avg_std:.4f}",f"{avg_skew:+.3f}",f"{avg_kurt:+.3f}"))
    rt("Component Statistics",cols,rows)
    return 0
def main():
    ap=argparse.ArgumentParser(prog="rwkv-quant",description="RWKV-7 Quantization Toolkit",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="Examples:\n  rqkv info -m model.pth\n  rqkv list\n  rqkv quantize -m model.pth -o q.pth -s fp8\n  rqkv compare -m model.pth\n  rqkv eval -b orig.pth -q q.pth\n  rqkv sensitivity -m model.pth")
    sp=ap.add_subparsers(dest="cmd",help="command")
    # info
    s=sp.add_parser("info",help="Show model info [aliases: i, info]");s.add_argument("-m","--model",required=True)
    # list
    sp.add_parser("list",help="List quantization schemes [aliases: l, li]")
    # quantize
    s=sp.add_parser("quantize",help="Quantize a model [aliases: q, quant]")
    s.add_argument("-m","--model",required=True);s.add_argument("-o","--output",required=True)
    s.add_argument("-s","--scheme",default="fp8")
    # compare
    s=sp.add_parser("compare",help="Compare all schemes [aliases: c, cmp]")
    s.add_argument("-m","--model",required=True);s.add_argument("-C","--outdir",default=None)
    # eval
    s=sp.add_parser("eval",help="Evaluate quantized model [aliases: e, eval]")
    s.add_argument("-b","--baseline",required=True);s.add_argument("-q","--quantized",required=True)
    # sensitivity
    s=sp.add_parser("sensitivity",help="Per-tensor sensitivity [aliases: s, sens]")
    s.add_argument("-m","--model",required=True)

    ABBREV = {"l":"list","li":"list","i":"info","q":"quantize","quant":"quantize","c":"compare","cmp":"compare","e":"eval","s":"sensitivity","sens":"sensitivity"}
    if sys.argv[1:] and sys.argv[1] in ABBREV:
        sys.argv[1] = ABBREV[sys.argv[1]]
    args=ap.parse_args()
    if not args.cmd:ap.print_help();return 0
    CMDS={"info":cmd_info,"list":cmd_list,"quantize":cmd_quantize,"compare":cmd_compare,"eval":cmd_eval,"sensitivity":cmd_sensitivity}
    if args.cmd not in CMDS:print(f"Unknown: {args.cmd}");return 1
    return CMDS[args.cmd](args)

if __name__=="__main__":raise SystemExit(main())
