def cmd_sensitivity(args):
    import torch
    p=args.model
    if not p: err_exit("-m/--model is required")
    z, nl = load_state(p)
    from collections import defaultdict; groups=defaultdict(list)
    print(f"  {dm('⏳ Analyzing:')} {p} ({nl} layers)\n")
    for k in sorted(z.keys()):
        v=z[k]; info=clsf(k,nl); comp=info[1] if info else "other"
        if isinstance(v,torch.Tensor) and v.dim()==2 and v.numel()>=10000:
            wf=v.float(); sv=float(wf.std())
            sk=float(((wf-wf.mean())**3).mean()/(sv**3+1e-20))
            ku=float(((wf-wf.mean())**4).mean()/(sv**4+1e-20)-3)
            groups[comp].append(dict(std=sv,skew=sk,kurt=ku))
    if _RICH:
        t=Table(title="[bold magenta]✦ Tensor Statistics ✦[/]", box=box.ROUNDED, header_style="bold cyan")
        t.add_column("Component", style="bold"); t.add_column("Count", justify="right")
        t.add_column("Avg Std", justify="right"); t.add_column("Avg Skew", justify="right"); t.add_column("Avg Kurt", justify="right")
        for comp in sorted(groups.keys()):
            g=groups[comp]; n=len(g)
            if n==0: continue
            t.add_row(comp, str(n), f"{sum(x['std'] for x in g)/n:.4f}", f"{sum(x['skew'] for x in g)/n:+.3f}", f"{sum(x['kurt'] for x in g)/n:+.3f}")
        _r.print(t)
    else:
        print(f"{hd('✦ Tensor Statistics ✦')}")
        for comp in sorted(groups.keys()):
            g=groups[comp]; n=len(g)
            if n==0: continue
            print(f"  {ok(comp):16s} n={n:3d}  std={sum(x['std'] for x in g)/n:.4f}  skew={sum(x['skew'] for x in g)/n:+.3f}  kurt={sum(x['kurt'] for x in g)/n:+.3f}")
    return 0
def main():
    ap=argparse.ArgumentParser(prog="rwkv-quant",description="RWKV-7 Quantization Toolkit",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Examples:
  rwkv-quant info -m model.pth
  rwkv-quant list
  rwkv-quant quantize -m model.pth -o ./out -s fp8
  rwkv-quant compare -m model.pth
  rwkv-quant eval -b orig.pth -q q.pth
  rwkv-quant sensitivity -m model.pth
Aliases: i/l/q/c/e/s""")
    ap.add_argument("-B","--no-banner", action="store_true", help="skip banner (faster)")
    sp=ap.add_subparsers(dest="cmd",help="command")
    s=sp.add_parser("info",help="Show model info [i]");s.add_argument("-m","--model",default=None)
    sp.add_parser("list",help="List quantization schemes [l]")
    s=sp.add_parser("quantize",help="Quantize a model [q]");s.add_argument("-m","--model",default=None);s.add_argument("-o","--output",default=None);s.add_argument("-s","--scheme",default="fp8")
    s=sp.add_parser("compare",help="Compare all schemes [c]");s.add_argument("-m","--model",default=None);s.add_argument("-C","--outdir",default=None)
    s=sp.add_parser("eval",help="Evaluate quantized model [e]");s.add_argument("-b","--baseline",default=None);s.add_argument("-q","--quantized",default=None)
    s=sp.add_parser("sensitivity",help="Per-tensor stats [s]");s.add_argument("-m","--model",default=None)

    global NO_BANNER
    if "--no-banner" in sys.argv or "-B" in sys.argv:
        NO_BANNER = True
    ABBREV={"l":"list","li":"list","i":"info","q":"quantize","quant":"quantize","c":"compare","cmp":"compare","e":"eval","s":"sensitivity","sens":"sensitivity"}
    # Scan argv for the first positional (subcommand) and expand abbreviation
    for _i, _a in enumerate(sys.argv[1:]):
        if not _a.startswith("-"):
            if _a in ABBREV:
                sys.argv[_i+1]=ABBREV[_a]
            break

    args=ap.parse_args()
    if not args.cmd:
        show_banner()
        ap.print_help()
        return 0
    CMDS={"info":cmd_info,"list":cmd_list,"quantize":cmd_quantize,"compare":cmd_compare,"eval":cmd_eval,"sensitivity":cmd_sensitivity}
    if args.cmd not in CMDS: err_exit(f"unknown command '{args.cmd}'")
    # Show banner only for heavy commands, and only if not suppressed
    if args.cmd in ("quantize","compare","eval","sensitivity","info"):
        show_banner()
    return CMDS[args.cmd](args)

if __name__=="__main__":
    raise SystemExit(main())
