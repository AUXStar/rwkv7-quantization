def _load(path,prompts):
    import torch
    sys.path.insert(0,ENGINE);import rwkv7_fast_v3a as v3a
    from rwkv.rwkv_tokenizer import TRIE_TOKENIZER;import rwkv
    tok=TRIE_TOKENIZER(VOCAB)
    v3a.MODEL_PATH=path;v3a.WKV_MODE="fp16";v3a.EMB_DEVICE="cpu"
    v3a.RKV_MODE="off";v3a.CMIX_SPARSE="off";v3a.LOWRANK_WEIGHT="transpose"
    v3a.ORIG_LINEAR_GROUPS={"head"};v3a.load_extensions(v3a.WKV_MODE)
    model=v3a.RWKV7();logs=[]
    for pr in prompts:
        toks=tok.encode(pr)[:512]
        inp=torch.tensor(toks,dtype=torch.long,device="cuda").unsqueeze(0)
        st=model.zero_state(1)
        with torch.no_grad():lg=model.forward_all_logits(inp,st)
        if lg.dim()==3:lg=lg[0]
        logs.append(lg.cpu().float())
    del model
    for m in list(sys.modules.keys()):
        if any(x in m for x in ["fp8_ops","fused_fp8","rwkv7_fast"]):del sys.modules[m]
    gc.collect();torch.cuda.empty_cache()
    return logs

def _ear(lo,lq):
    import torch,torch.nn.functional as F
    te=tt=t=0.0
    for a,b in zip(lo,lq):
        mn=min(a.size(0),b.size(0));a,b=a[:mn],b[:mn]
        pa,pb=F.softmax(a,-1),F.softmax(b,-1)
        te+=torch.minimum(pa,pb).sum().item()
        tt+=(a.argmax(-1)==b.argmax(-1)).float().sum().item()
        t+=mn
    return te/t,tt/t

def _speed(path,warmup=3,steps=20):
    import torch
    sys.path.insert(0,ENGINE);import rwkv7_fast_v3a as v3a
    from rwkv.rwkv_tokenizer import TRIE_TOKENIZER;import rwkv
    tok=TRIE_TOKENIZER(VOCAB)
    v3a.MODEL_PATH=path;v3a.WKV_MODE="fp16";v3a.EMB_DEVICE="cpu"
    v3a.RKV_MODE="off";v3a.CMIX_SPARSE="off";v3a.LOWRANK_WEIGHT="transpose"
    v3a.ORIG_LINEAR_GROUPS={"head"};v3a.load_extensions(v3a.WKV_MODE)
    model=v3a.RWKV7()
    toks=tok.encode("Write a Python function")[:128]
    inp=torch.tensor(toks,dtype=torch.long,device="cuda").unsqueeze(0)
    for _ in range(warmup):st=model.zero_state(1);model.forward(inp,st)
    torch.cuda.synchronize();t0=time.time();st=model.zero_state(1)
    with torch.no_grad():
        model.forward(inp,st)
        for _ in range(steps):
            nt=torch.argmax(st[-1][-1]).unsqueeze(0).unsqueeze(0)
            model.forward(nt,st)
    torch.cuda.synchronize();dt=time.time()-t0;del model
    for m in list(sys.modules.keys()):
        if any(x in m for x in ["fp8_ops","fused_fp8","rwkv7_fast"]):del sys.modules[m]
    gc.collect();torch.cuda.empty_cache()
    return steps/dt
